---
import { categoriasProdutos, type CategoriaProduto } from '@data/products';
import { getProductWhatsAppLink } from '@data/site';

const iconeCategoria: Record<string, string> = {
  vinhos:
    '<path d="M12 2v4"/><path d="M12 21v-5"/><path d="M8 6h8"/><path d="M8 6v4a4 4 0 0 0 8 0V6"/><path d="M8 15a4 4 0 0 0 8 0"/><path d="M7 4l-1 2"/><path d="M17 4l1 2"/>',
  bebidas:
    '<path d="M9 2h6v4l4 10a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4l4-10V2Z"/><path d="M8 14h8"/>',
  laticinios:
    '<rect x="4" y="7" width="16" height="14" rx="2"/><path d="M4 12h16"/><path d="M7 7l3-4h4l3 4"/>',
  embutidos:
    '<path d="M4 13c0-3 2-5 4-5s3 2 5 2 4-2 7 2-2 5-5 5-4-2-7-2-4 2-4 2Z"/><path d="M11 10l-2 2"/><path d="M14 8l-2 2"/><path d="M17 10l-2 2"/><path d="M9 14l-2 2"/><path d="M12 12l-2 2"/><path d="M15 14l-2 2"/>',
  cosmeticos:
    '<path d="M10 2h4v3h-4z"/><rect x="8" y="5" width="8" height="17" rx="2"/><path d="M8 11h8"/>'
};
---

<section id="produtos" class="section bg-white">
  <div class="container">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 sm:mb-14 md:mb-16">
      <div class="max-w-2xl">
        <span class="section-eyebrow">Curadoria</span>
        <h2 class="section-title text-balance">Nossos Produtos</h2>
        <p class="mt-4 section-subtitle">
          Uma seleção pensada para encantar. Confira as principais categorias comercializadas pela Adega Vista Alegre e solicite informações detalhadas.
        </p>
      </div>
      <a
        href="#contato"
        class="btn-secondary self-start md:self-end"
        data-partnership="compras"
      >
        Comprar produtos
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categoriasProdutos.map((cat: CategoriaProduto, idx: number) => {
        const ultimoFull = idx === categoriasProdutos.length - 1;
        return (
          <a
            key={cat.slug}
            id={`prod-${cat.slug}`}
            href={getProductWhatsAppLink(cat.nome.toLowerCase())}
            target="_blank"
            rel="noopener noreferrer"
            class={`group relative overflow-hidden rounded-[1.75rem] shadow-card border border-cream-200/70 hover:shadow-hover transition-all duration-300 aspect-[4/3] sm:aspect-[4/3] ${
              ultimoFull ? 'sm:col-span-2 lg:col-span-1' : ''
            }`}
            aria-label={`Receber mais informações sobre ${cat.nome}`}
          >
            <img
              src={cat.imagem}
              alt={cat.imagemAlt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
              width="800"
              height="600"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-ink-900/85 via-ink-900/40 to-ink-900/5 group-hover:from-ink-900/90 transition-all duration-300"></div>

            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7 md:p-8 flex items-end justify-between gap-5">
              <div class="flex items-center gap-4">
                <span class="shrink-0 w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white/92 backdrop-blur-sm text-wine-700 flex items-center justify-center shadow-soft border border-wine-700/10 group-hover:bg-wine-700 group-hover:text-white transition-colors duration-200" aria-hidden="true">
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={iconeCategoria[cat.slug]} />
                </span>
                <div class="min-w-0">
                  <h3 class="font-display text-2xl sm:text-3xl md:text-4xl font-semibold text-white leading-tight text-pretty">
                    {cat.nome}
                  </h3>
                  <p class="mt-1.5 text-sm sm:text-base text-white/80 leading-relaxed line-clamp-2 max-w-xl">
                    {cat.descricao}
                  </p>
                </div>
              </div>

              <span class="shrink-0 inline-flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white text-wine-700 border border-white/20 shadow-soft group-hover:bg-wine-700 group-hover:text-white group-hover:translate-x-0.5 transition-all duration-200" aria-hidden="true">
                <svg class="w-5 h-5 sm:w-5.5 sm:h-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
