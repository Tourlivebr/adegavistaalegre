---
import { categoriasProdutos, type CategoriaProduto } from '@data/products';
import { getProductWhatsAppLink } from '@data/site';
---

<section id="produtos" class="section bg-white">
  <div class="container">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <div class="max-w-2xl">
        <span class="section-eyebrow">Curadoria</span>
        <h2 class="section-title text-balance">Nossos Produtos</h2>
        <p class="mt-4 section-subtitle">
          Uma seleção pensada para encantar. Confira as principais categorias comercializadas pela Adega Vista Alegre e solicite informações detalhadas.
        </p>
      </div>
      <a
        href="#contato"
        class="btn-secondary self-start md:self-end"
        data-partnership="compras"
      >
        Comprar produtos
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categoriasProdutos.map((cat: CategoriaProduto) => (
        <article
          key={cat.slug}
          class="card-elegant group flex flex-col overflow-hidden p-0"
          aria-labelledby={`prod-${cat.slug}`}
        >
          <a
            href={getProductWhatsAppLink(cat.nome.toLowerCase())}
            target="_blank"
            rel="noopener noreferrer"
            class="block relative aspect-[4/3] overflow-hidden rounded-t-2xl"
            aria-label={`Receber mais informações sobre ${cat.nome}`}
          >
            <img
              src={cat.imagem}
              alt={cat.imagemAlt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
              width="600"
              height="450"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-ink-900/10 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            <div class="absolute top-4 left-4 tag-eyebrow bg-white/90 backdrop-blur-sm">
              {cat.nome}
            </div>
          </a>
          <div class="flex-1 flex flex-col p-6">
            <h3 id={`prod-${cat.slug}`} class="font-display text-xl md:text-2xl font-semibold text-ink-900">
              {cat.nome}
            </h3>
            <p class="mt-3 text-ink-500 leading-relaxed text-pretty">
              {cat.descricao}
            </p>
            <div class="mt-6 pt-6 border-t border-cream-200 mt-auto">
              <a
                href={getProductWhatsAppLink(cat.nome.toLowerCase())}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-wine-700 font-semibold hover:text-wine-800 transition-colors group/link"
              >
                Tenho interesse
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-wine-50 text-wine-700 border border-wine-700/10 group-hover/link:bg-wine-700 group-hover/link:text-white transition-all">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
