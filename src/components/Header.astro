---
import { menuLinks, site, getWhatsAppLink } from '@data/site';
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-transparent"
>
  <div class="container">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a
        href="#inicio"
        class="flex items-center gap-2.5 group shrink-0"
        aria-label="Adega Vista Alegre - Ir para o início"
      >
        <span
          class="w-9 h-9 md:w-10 md:h-10 rounded-lg bg-wine-700 text-white flex items-center justify-center font-display text-lg font-bold transition-transform duration-300 group-hover:scale-105"
          aria-hidden="true"
        >
          V
        </span>
        <span class="flex flex-col leading-tight">
          <span class="font-display text-lg md:text-xl font-semibold text-ink-900 tracking-tight">
            Vista Alegre
          </span>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.18em] text-wine-700 font-semibold">
            Adega
          </span>
        </span>
      </a>

      <nav
        class="hidden lg:flex items-center gap-8"
        aria-label="Navegação principal"
      >
        {
          menuLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-ink-700 hover:text-wine-700 transition-colors duration-200 relative py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-0.5 after:w-0 after:bg-wine-700 hover:after:w-full after:transition-all after:duration-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden lg:flex items-center gap-3">
        <a
          href={getWhatsAppLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary !py-2.5 !px-4 text-sm"
          aria-label="Falar no WhatsApp"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden w-11 h-11 -mr-2 inline-flex items-center justify-center rounded-lg text-ink-800 hover:bg-cream-100 transition-colors"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-white border-t border-cream-200 max-h-[calc(100vh-5rem)] overflow-y-auto"
  >
    <div class="container py-4 flex flex-col gap-1">
      {
        menuLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-link px-4 py-3 rounded-lg text-ink-800 hover:bg-cream-100 hover:text-wine-700 font-medium transition-colors"
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-4 mt-2 border-t border-cream-200">
        <a
          href={getWhatsAppLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Fale no WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  body {
    padding-top: 4rem;
  }
  @media (min-width: 768px) {
    body { padding-top: 5rem; }
  }
</style>

<script>
  const header = document.getElementById('header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = menu?.querySelectorAll('.mobile-link');

  function setScrolled() {
    if (!header) return;
    if (window.scrollY > 12) {
      header.classList.add('border-cream-200', 'shadow-[0_1px_0_rgba(0,0,0,0.04)]');
    } else {
      header.classList.remove('border-cream-200', 'shadow-[0_1px_0_rgba(0,0,0,0.04)]');
    }
  }
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    } else {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
</script>
