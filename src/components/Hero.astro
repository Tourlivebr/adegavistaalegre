---
import { site, getWhatsAppLink } from '@data/site';
const heroImage = 'https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Premium%20wine%20bottles%20on%20elegant%20wooden%20shelves%20in%20modern%20cellar%20with%20soft%20warm%20lighting%2C%20gourmet%20gastronomy%20photography%2C%20photorealistic%2C%20high%20detail&image_size=landscape_16_9';
---

<section id="inicio" class="relative overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src={heroImage}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/85 to-white/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-white/50 md:to-transparent"></div>
  </div>

  <div class="container relative z-10 min-h-[88vh] md:min-h-[92vh] flex items-center py-16 md:py-20">
    <div class="w-full lg:w-[58%] xl:w-[52%]">
      <span class="tag-eyebrow mb-6 opacity-0 animate-[fadeUp_0.6s_0.1s_forwards]">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Adega Premium
      </span>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-semibold text-ink-900 leading-[1.05] tracking-tight text-balance opacity-0 animate-[fadeUp_0.6s_0.2s_forwards]">
        <span class="block">{site.nome}</span>
      </h1>

      <p class="mt-6 text-xl md:text-2xl font-display text-wine-700 leading-tight opacity-0 animate-[fadeUp_0.6s_0.3s_forwards]">
        {site.slogan}
      </p>

      <p class="mt-6 text-ink-600 text-base md:text-lg leading-relaxed max-w-xl text-pretty opacity-0 animate-[fadeUp_0.6s_0.4s_forwards]">
        Atendimento comercial para empresas, profissionais do turismo, guias e parceiros interessados em produtos selecionados e oportunidades de comissão.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 opacity-0 animate-[fadeUp_0.6s_0.5s_forwards]">
        <a href="#produtos" class="btn-primary min-h-[3.25rem]">
          Conheça nossos produtos
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a href="#contato" class="btn-secondary min-h-[3.25rem]" data-partnership="divulgacao">
          Quero ser parceiro
        </a>
        <a
          href={getWhatsAppLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp min-h-[3.25rem]"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          </svg>
          Chamar no WhatsApp
        </a>
      </div>

      <div class="mt-14 grid grid-cols-3 gap-4 max-w-lg opacity-0 animate-[fadeUp_0.6s_0.6s_forwards]">
        {[
          ['+', 'Categorias', 'Selecionadas'],
          ['+', 'Atendimento', 'Personalizado'],
          ['+', 'Parcerias', 'Comerciais']
        ].map(([suf, t1, t2]) => (
          <div key={`${t1}-${t2}`} class="relative pl-4 before:content-[''] before:absolute before:left-0 before:top-1.5 before:h-8 before:w-0.5 before:bg-wine-700/40">
            <p class="font-display text-2xl md:text-3xl text-wine-700 font-semibold leading-none">
              {suf}<span class="sr-only">5</span>
            </p>
            <p class="mt-1 text-xs md:text-sm text-ink-700 leading-tight">
              <span class="block font-medium">{t1}</span>
              <span class="block text-ink-500">{t2}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-white to-transparent pointer-events-none z-10"></div>
</section>

<script is:global>
  window.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('ava_visited') === '1') return;
    localStorage.setItem('ava_visited', '1');
    document.querySelectorAll('#inicio [style*="opacity:0"]').forEach((el) => {
      (el as HTMLElement).style.animationPlayState = 'running';
    });
  });
  const style = document.createElement('style');
  style.textContent = `
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      #inicio [style*="animate-"] { animation: none !important; opacity: 1 !important; transform: none !important; }
    }
  `;
  document.head.appendChild(style);
</script>
