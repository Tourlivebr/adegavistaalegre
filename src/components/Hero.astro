---
import { site, getWhatsAppLink } from '@data/site';
---

<section id="inicio" class="relative overflow-hidden bg-ink-900 text-white">
  <div class="absolute inset-0 z-0">
    <img
      src={site.representante.foto || 'https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Elegant%20professional%20latina%20business%20woman%20wine%20industry%20portrait%20on%20dark%20moody%20classical%20background%20green%20velvet%20chair&image_size=portrait_4_3'}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-top sm:object-center md:object-[center_20%]"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-900 via-ink-900/85 to-ink-900/20 md:from-ink-900 md:via-ink-900/70 md:to-ink-900/10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/10 to-ink-900/60 sm:to-transparent"></div>
  </div>

  <div class="container relative z-10 min-h-[calc(100svh-4rem)] sm:min-h-[calc(100svh-5rem)] md:min-h-[90svh] flex items-center py-10 sm:py-14 md:py-20">
    <div class="w-full md:w-1/2 lg:w-[55%] xl:w-[50%]">
      <span class="inline-block mb-5 text-xs sm:text-sm font-semibold uppercase tracking-[0.22em] text-cream-100/90">
        Representação
        <br class="sm:hidden" />
        Comercial
      </span>

      <h1 class="font-display text-[2.5rem] leading-[1.05] sm:text-5xl md:text-6xl lg:text-7xl font-semibold text-white tracking-tight text-balance">
        <span class="block">Representação</span>
        <span class="block">Comercial</span>
        <span class="block">Adega Vista Alegre</span>
      </h1>

      <div class="relative mt-7 pl-5 border-l-2 border-wine-700/70 max-w-lg">
        <p class="text-cream-100/90 italic text-base sm:text-lg md:text-xl leading-relaxed">
          &ldquo;{site.representante.apresentacao}&rdquo;
        </p>
      </div>

      <div class="mt-9 flex flex-col gap-3 w-full max-w-sm">
        <a
          href={site.representante.whatsapp ? `https://wa.me/${site.representante.whatsapp}` : getWhatsAppLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between gap-3 px-5 sm:px-6 py-4 bg-[#25D366] text-ink-900 font-semibold rounded-2xl transition-all duration-200 hover:bg-[#1FBF5B] hover:shadow-[0_10px_30px_-10px_rgba(37,211,102,0.5)] active:scale-[0.99] min-h-[3.75rem]"
        >
          <span class="inline-flex items-center gap-3">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Falar no WhatsApp
          </span>
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>

        <a
          href={site.representante.instagram || site.redes.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between gap-3 px-5 sm:px-6 py-4 bg-white text-wine-700 font-semibold rounded-2xl border border-white transition-all duration-200 hover:bg-cream-100 active:scale-[0.99] min-h-[3.75rem]"
        >
          <span class="inline-flex items-center gap-3">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.849.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.849.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm5.202-9.802a1.44 1.44 0 112.88 0 1.44 1.44 0 01-2.88 0z"/>
            </svg>
            Instagram
          </span>
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>

        <a
          href={site.representante.email ? `mailto:${site.representante.email}` : `mailto:${site.email.contato}`}
          class="inline-flex items-center justify-between gap-3 px-5 sm:px-6 py-4 bg-white text-ink-900 font-semibold rounded-2xl border border-white transition-all duration-200 hover:bg-cream-100 active:scale-[0.99] min-h-[3.75rem]"
        >
          <span class="inline-flex items-center gap-3">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            Enviar e-mail
          </span>
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
