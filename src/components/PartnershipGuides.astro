---
const beneficios = [
  {
    titulo: 'Indique clientes',
    texto: 'Encaminhe turistas, visitantes e contatos interessados em produtos selecionados.',
    icone: 'users'
  },
  {
    titulo: 'Gere oportunidades',
    texto: 'Conecte demandas de grupos, hotéis, restaurantes e eventos aos nossos produtos.',
    icone: 'trending-up'
  },
  {
    titulo: 'Receba comissão',
    texto: 'Seja recompensado por cada parceria consolidada, com condições comerciais justas.',
    icone: 'dollar-sign'
  },
  {
    titulo: 'Atendimento personalizado',
    texto: 'Suporte dedicado da representante comercial em todas as etapas da parceria.',
    icone: 'message-circle'
  },
  {
    titulo: 'Parceria de longo prazo',
    texto: 'Construa uma relação comercial sólida com produtos de qualidade consistente.',
    icone: 'heart'
  }
];

const iconeSvg = {
  'users': `<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>`,
  'trending-up': `<path d="M3 3v18h18"/><path d="M7 15l4-4 4 4 5-5"/>`,
  'dollar-sign': `<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>`,
  'message-circle': `<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>`,
  'heart': `<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>`
};
---

<section id="guias" class="section bg-white relative">
  <div class="container">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <span class="tag-eyebrow mb-4">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Guia de Turismo
        </span>
        <h2 class="section-title text-balance">
          Guia de Turismo, seja nosso parceiro
        </h2>
        <p class="mt-6 text-ink-600 text-lg leading-relaxed text-pretty">
          Guias de turismo poderão indicar clientes e oportunidades comerciais para a Adega Vista Alegre e receber comissão de acordo com as condições comerciais da parceria.
        </p>
        <div class="mt-8 p-6 rounded-2xl bg-wine-50 border border-wine-700/10">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 shrink-0 rounded-lg bg-wine-700 text-white flex items-center justify-center" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            </div>
            <p class="text-sm text-wine-800 leading-relaxed">
              As condições de comissão e detalhes comerciais são apresentados diretamente pela representante após o cadastro. Sem taxas de adesão.
            </p>
          </div>
        </div>
        <div class="mt-10">
          <a
            href="#contato"
            class="btn-primary"
            data-partnership="guia"
          >
            Quero ser um Guia Parceiro
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid sm:grid-cols-2 gap-5">
          {beneficios.map((b, i) => (
            <div
              key={b.titulo}
              class="card-elegant"
              style={i === beneficios.length - 1 ? { gridColumn: '1 / -1' } : undefined}
            >
              <div class="w-12 h-12 rounded-xl bg-wine-50 text-wine-700 border border-wine-700/10 flex items-center justify-center mb-4" aria-hidden="true">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconeSvg[b.icone]} />
              </div>
              <h3 class="font-display text-lg font-semibold text-ink-900 mb-2">{b.titulo}</h3>
              <p class="text-ink-500 leading-relaxed text-sm">{b.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
