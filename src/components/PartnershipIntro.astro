---
import { site } from '@data/site';
---

<section id="sobre" class="section bg-white relative overflow-hidden">
  <div class="absolute right-0 top-0 bottom-0 w-full sm:w-[60%] lg:w-[55%] pointer-events-none opacity-20 sm:opacity-25" aria-hidden="true">
    <svg class="w-full h-full" viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g transform="translate(60 40) scale(1.1)" opacity="0.9">
        <path d="M120 20 C 95 10 60 12 40 35 C 18 58 22 95 48 115 C 28 130 18 160 40 180 C 60 200 95 195 120 175 C 145 195 180 200 200 180 C 222 160 212 130 192 115 C 218 95 222 58 200 35 C 180 12 145 10 120 20 Z" fill="#6D1830" fill-opacity="0.08" />
        <circle cx="80" cy="70" r="7" fill="#6D1830" fill-opacity="0.35"/>
        <circle cx="100" cy="85" r="7" fill="#6D1830" fill-opacity="0.3"/>
        <circle cx="90" cy="105" r="7" fill="#6D1830" fill-opacity="0.4"/>
        <circle cx="72" cy="115" r="6" fill="#6D1830" fill-opacity="0.3"/>
        <circle cx="115" cy="60" r="6.5" fill="#6D1830" fill-opacity="0.32"/>
        <circle cx="140" cy="80" r="7" fill="#6D1830" fill-opacity="0.35"/>
        <circle cx="160" cy="105" r="7" fill="#6D1830" fill-opacity="0.3"/>
        <circle cx="145" cy="130" r="6.5" fill="#6D1830" fill-opacity="0.4"/>
        <circle cx="175" cy="70" r="6" fill="#6D1830" fill-opacity="0.28"/>
        <circle cx="110" cy="130" r="7" fill="#6D1830" fill-opacity="0.35"/>
        <circle cx="180" cy="135" r="7" fill="#6D1830" fill-opacity="0.3"/>
        <path d="M80 30 Q 75 10 95 5" stroke="#6D1830" stroke-opacity="0.4" stroke-width="1.5" fill="none"/>
        <path d="M145 22 Q 155 5 172 8" stroke="#6D1830" stroke-opacity="0.4" stroke-width="1.5" fill="none"/>
        <path d="M115 30 L 115 0 M 110 10 L 120 10 M 108 20 L 122 20" stroke="#6D1830" stroke-opacity="0.3" stroke-width="1.5" fill="none"/>
      </g>
      <g transform="translate(200 200) scale(0.85)" opacity="0.7">
        <path d="M120 20 C 95 10 60 12 40 35 C 18 58 22 95 48 115 C 28 130 18 160 40 180 C 60 200 95 195 120 175 C 145 195 180 200 200 180 C 222 160 212 130 192 115 C 218 95 222 58 200 35 C 180 12 145 10 120 20 Z" fill="#6D1830" fill-opacity="0.07" />
        <circle cx="80" cy="70" r="6" fill="#6D1830" fill-opacity="0.25"/>
        <circle cx="100" cy="85" r="6" fill="#6D1830" fill-opacity="0.22"/>
        <circle cx="90" cy="105" r="6" fill="#6D1830" fill-opacity="0.3"/>
        <circle cx="140" cy="80" r="6" fill="#6D1830" fill-opacity="0.25"/>
        <circle cx="160" cy="105" r="6" fill="#6D1830" fill-opacity="0.22"/>
        <circle cx="145" cy="130" r="6" fill="#6D1830" fill-opacity="0.28"/>
        <circle cx="110" cy="130" r="6" fill="#6D1830" fill-opacity="0.25"/>
      </g>
      <g transform="translate(40 260) scale(0.7)" opacity="0.55">
        <path d="M120 20 C 95 10 60 12 40 35 C 18 58 22 95 48 115 C 28 130 18 160 40 180 C 60 200 95 195 120 175 C 145 195 180 200 200 180 C 222 160 212 130 192 115 C 218 95 222 58 200 35 C 180 12 145 10 120 20 Z" fill="#6D1830" fill-opacity="0.06" />
      </g>
    </svg>
  </div>

  <div class="container relative">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-7 xl:col-span-8 relative">
        <span class="section-eyebrow !mb-4">Conexões que geram negócios</span>

        <h2 class="section-title text-balance max-w-lg">
          Mais que vinhos,
          <br />
          boas parcerias
        </h2>

        <div class="mt-4 h-1 w-20 bg-wine-700 rounded-full"></div>

        <p class="mt-7 text-ink-500 sm:text-ink-600 text-base sm:text-lg leading-relaxed max-w-xl text-pretty">
          Representamos a {site.nome}, conectando produtos de excelência a novos mercados e experiências inesquecíveis.
        </p>

        <a
          href="#contato"
          class="mt-8 inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-wine-700 text-white font-medium rounded-xl transition-all duration-200 hover:bg-wine-800 active:scale-[0.98]"
          data-partnership="compras"
        >
          Vamos conversar
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <div class="lg:col-span-5 xl:col-span-4 relative hidden sm:block">
        <div class="text-right">
          <p
            class="font-display text-wine-700/50 leading-[0.95] tracking-tight text-right"
            style="font-size: clamp(2rem, 5vw, 2.75rem); font-style: italic;"
          >
            <span class="block">Vinhos que</span>
            <span class="block mt-1 sm:mt-2">conectam pessoas</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
