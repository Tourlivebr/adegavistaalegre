---
const itens = [
  {
    t: 'Produtos',
    d: 'Consulte disponibilidade, catálogos detalhados e novidades.',
    i: 'package'
  },
  {
    t: 'Disponibilidade',
    d: 'Estoque atualizado para atender demandas do seu negócio.',
    i: 'clock'
  },
  {
    t: 'Condições comerciais',
    d: 'Preços e prazos pensados para volume e recorrência.',
    i: 'dollar-sign'
  },
  {
    t: 'Atendimento',
    d: 'Representante comercial dedicado ao seu pedido.',
    i: 'message-circle'
  },
  {
    t: 'Distribuição',
    d: 'Logística para sua região, conforme a demanda.',
    i: 'truck'
  }
];

const iconeSvg = {
  'package': `<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>`,
  'clock': `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
  'dollar-sign': `<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>`,
  'message-circle': `<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>`,
  'truck': `<rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>`
};
---

<section id="empresas" class="section bg-white">
  <div class="container">
    <div class="relative overflow-hidden rounded-3xl bg-ink-900 text-white">
      <div class="absolute inset-0 opacity-20">
        <img
          src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Premium%20wine%20cellar%20shelves%20filled%20with%20bottles%20dark%20moody%20ambient%20lighting%2C%20cinematic&image_size=landscape_16_9"
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-br from-ink-900 via-ink-900/95 to-wine-900/70"></div>

      <div class="relative grid lg:grid-cols-12 gap-10 p-8 sm:p-12 lg:p-16">
        <div class="lg:col-span-5">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-wine-700/30 text-wine-200 border border-wine-500/30">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M9 9h6v6H9z"/>
            </svg>
            Para empresas
          </span>
          <h2 class="mt-5 font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-white leading-tight text-balance">
            Produtos para sua empresa
          </h2>
          <p class="mt-5 text-cream-300/90 text-lg leading-relaxed max-w-lg">
            Hotéis, restaurantes, pousadas, eventos, mercados e empresas de diversos segmentos contam com a Vista Alegre para abastecer seu cardápio, eventos e presentes corporativos.
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-3">
            <a
              href="#contato"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-ink-900 font-medium rounded-lg transition-all duration-200 hover:bg-cream-100 active:scale-[0.98] min-h-[3.25rem]"
              data-partnership="compras"
            >
              Quero comprar
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a
              href="#representante"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white/5 text-white font-medium rounded-lg border border-white/15 hover:bg-white/10 transition-all min-h-[3.25rem]"
            >
              Falar com representante
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {itens.map((item, i) => (
              <div
                key={item.t}
                class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 hover:border-wine-400/30 transition-all"
                style={i === itens.length - 1 ? { gridColumn: '2 / -1' } : undefined}
              >
                <div class="w-10 h-10 rounded-lg bg-wine-700/40 text-wine-200 flex items-center justify-center mb-4" aria-hidden="true">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconeSvg[item.i]} />
                </div>
                <h3 class="font-display text-lg font-semibold text-white mb-1.5">{item.t}</h3>
                <p class="text-sm text-cream-300/80 leading-relaxed">{item.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
