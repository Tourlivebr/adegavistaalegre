---
const categorias = [
  { nome: 'Vinhos', slug: 'vinhos', i: 'wine' },
  { nome: 'Bebidas', slug: 'bebidas', i: 'bottle' },
  { nome: 'Laticínios', slug: 'laticinios', i: 'cheese' },
  { nome: 'Embutidos', slug: 'embutidos', i: 'salami' },
  { nome: 'Cosméticos', slug: 'cosmeticos', i: 'cosmetic' }
];

const iconeSvg = {
  wine: `<path d="M8 2h8l-1 6a4 4 0 01-6 0L8 2z"/><path d="M12 12v10"/><path d="M8 22h8"/>`,
  bottle: `<path d="M8 2h8v3l-2 3v11a2 2 0 01-2 2h-0a2 2 0 01-2-2V8L8 5V2z"/><path d="M8 6h8"/>`,
  cheese: `<path d="M4 10a2 2 0 012-2h12l4 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V10z"/><circle cx="9" cy="14" r="1"/><circle cx="13" cy="16" r="1"/><circle cx="17" cy="13" r="1"/>`,
  salami: `<path d="M3 12c2.5 0 2.5-3.5 5-3.5s2.5 7 5 7 2.5-7 5-7 2.5 3.5 5 3.5"/><path d="M3 17c2.5 0 2.5-3.5 5-3.5s2.5 7 5 7 2.5-7 5-7 2.5 3.5 5 3.5"/>`,
  cosmetic: `<path d="M10 2h4v3h-4z"/><rect x="8" y="5" width="8" height="17" rx="2"/><path d="M8 11h8"/>`
};
---

<section id="sobre-adega" class="section bg-white pt-12 md:pt-16">
  <div class="container">
    <div class="relative rounded-[1.75rem] md:rounded-[2rem] overflow-hidden shadow-card border border-cream-200/70 aspect-[4/3] sm:aspect-[16/10] md:aspect-[16/9] bg-cream-100">
      <img
        src="/img/tabua_frios.jpeg"
        alt="Produtos da Adega Vista Alegre: tábua de frios, queijos, embutidos, vinhos e taças em mesa de madeira"
        class="img-cover"
        loading="eager"
        decoding="async"
        width="1200"
        height="800"
      />
    </div>

    <div class="mt-10 sm:mt-14 md:mt-16 max-w-3xl">
      <span class="section-eyebrow">Sobre nós</span>

      <h2 class="section-title !text-[2.5rem] sm:!text-5xl md:!text-6xl leading-[1.05] text-balance">
        Conheça a Adega Vista Alegre
      </h2>

      <p class="mt-6 text-ink-500 sm:text-ink-600 text-base sm:text-lg md:text-xl leading-relaxed text-pretty">
        A Adega Vista Alegre trabalha com produtos selecionados para clientes, empresas e parceiros comerciais, oferecendo atendimento personalizado e oportunidades de parceria com condições comerciais justas e duradouras.
      </p>

      <p class="mt-5 text-ink-500 text-base sm:text-lg md:text-xl leading-relaxed text-pretty">
        Nossa curadoria é pensada para quem busca qualidade, sabor e confiança. Do vinho ao detalhe da apresentação, cuidamos de cada etapa para que a experiência seja sempre especial.
      </p>
    </div>

    <div class="mt-14 sm:mt-16 md:mt-20 flex flex-col items-center gap-4">
      <div class="w-8 h-8 text-wine-700/70 flex items-center justify-center" aria-hidden="true">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2c.6 2.2 2.2 3.4 4 3.4 1.5 0 2.6-.9 3-2.4.7 1.1 1 2.5.8 3.9-.3 1.9-1.5 3.1-3 3.1-1.6 0-3-1.1-3.6-2.7-.6 1.6-2 2.7-3.6 2.7-1.5 0-2.7-1.2-3-3.1-.2-1.4.1-2.8.8-3.9.4 1.5 1.5 2.4 3 2.4 1.8 0 3.4-1.2 4-3.4zM12 18c.7 1 1.9 1.6 3.2 1.6 2 0 3.2-1.3 3.2-2.6-.4.4-1 .6-1.6.6-1.5 0-2.7-1-3.2-2.2-.5 1.2-1.7 2.2-3.2 2.2-.6 0-1.2-.2-1.6-.6 0 1.3 1.2 2.6 3.2 2.6z"/>
        </svg>
      </div>
      <div class="w-full max-w-2xl flex items-center gap-4 text-wine-700/50">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-wine-700/30 to-wine-700/30"></div>
        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.3em] text-wine-800/70 whitespace-nowrap">
          Bons momentos, sempre
        </span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-wine-700/30 to-wine-700/30"></div>
      </div>
    </div>
  </div>
</section>
